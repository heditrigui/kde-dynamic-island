{
  "manifest_version": 3,
  "name": "Dynamic Island Tab Media",
  "version": "1.0",
  "description": "Shows each browser tab's audio and video in the KDE Dynamic Island.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
